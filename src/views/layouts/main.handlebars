<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ideas</title>
    <link rel="icon" type="image/png" sizes="16x16"  href="img/favicon-16x16.png">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <meta name="csrf-token" content="{{csrfToken}}">
</head>
<body>
    <nav id="nav">
        <a href="/" id="logo">
            <img src="/img/logo.png" alt="logo">
        </a>

        <ul>
            {{#if user.isAuthenticated}}
                {{#hasPermission user.type 'admin;root' }}
                    <li><a href="/admin">Admin</a></li>
                {{/hasPermission}}
                <li><a href="/">Ideas</a></li>
                <li><a href="/idea/yours">Yours</a></li>
                <li><a href="/logout">Logout</a></li>
            {{else}}
                <li><a href="/login">Login</a></li>
                <li><a href="/register">Register</a></li>
            {{/if}}
        </ul>
    </nav>
    <div class="container">
        {{#if messages.message}}
            {{> flashMessage message=messages.message}}
        {{/if}}
       {{{body}}}
    </div>
    <footer class="footer">
        <p><span><a href="#">Ideas</a></span> &copy; 2024</p>
    </footer>

    <script src="/js/idea.js"></script>
    <script>
        // Adiciona o token CSRF em todas as requisições AJAX
        document.addEventListener('DOMContentLoaded', function() {
            const token = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
            
            // Adiciona o token em todas as requisições fetch
            const originalFetch = window.fetch;
            window.fetch = function() {
                let [resource, config] = arguments;
                if(config === undefined) {
                    config = {};
                }
                if(config.headers === undefined) {
                    config.headers = {};
                }
                config.headers['X-CSRF-Token'] = token;
                return originalFetch(resource, config);
            };

            // Adiciona o token em todos os forms
            document.querySelectorAll('form').forEach(form => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = '_csrf';
                input.value = token;
                form.appendChild(input);
            });
        });
    </script>
</body>
</html>
