# Database
DB_NAME=idea
DB_USER=root
DB_PASS=root
DB_HOST=localhost
DB_DIALECT=mysql

# Session
SESSION_SECRET=perfectsecret
JWT_SECRET=jwtsecretkey

# Redis
REDIS_MAX_MEMORY=256mb
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=root

# App
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100